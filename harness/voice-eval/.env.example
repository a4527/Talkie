# 복사해서 `.env`로 저장하고 값을 채운다. `.env`는 Git에 올리지 않는다.
# 실제 키는 이 파일이나 대화, 문서, 로그에 붙여 넣지 않는다.
# 발급·결제 절차는 docs/harness/voice-eval/PROVIDERS.md를 따른다.

# 음성 인식
SONIOX_API_KEY=
DEEPGRAM_API_KEY=

# 텍스트 모델·음성 합성·실시간 참조
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Gemini API (Google AI Studio에서 발급한 키. 텍스트 모델, 음성 합성, Gemini Live 공통)
GOOGLE_API_KEY=

# 음성 합성
CARTESIA_API_KEY=
# 선택: Cartesia 목소리 ID (비우면 Pipecat 기본 예시 목소리)
CARTESIA_VOICE_ID=

# 학습 정책을 직접 확인한 업체(쉼표 구분). DEC-052: 확인하지 않은 업체가 들어간 구성은 시작하지 않는다.
# openai, anthropic은 확인됨이라 적지 않아도 된다. google은 유료(결제 활성) 프로젝트 키임을 확인한 뒤 적는다.
# 예: VOICE_EVAL_ACK=google,soniox
VOICE_EVAL_ACK=

# 선택: 지출 한도 덮어쓰기 (비우면 configs/matrix.yaml의 값)
VOICE_EVAL_SPEND_CAP_KRW=
