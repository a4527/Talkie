# Synthetic local testing only. Copy to app/.env; never commit the real file.
# Replace REPLACE_LOCALLY with independent local passwords in BOTH each URL and Compose variable.
TALKIE_RECORDS_PASSWORD=REPLACE_LOCALLY
TALKIE_TRANSCRIPTS_PASSWORD=REPLACE_LOCALLY
DATABASE_URL=postgresql://talkie:REPLACE_LOCALLY@127.0.0.1:5433/talkie
TRANSCRIPT_DATABASE_URL=postgresql://talkie:REPLACE_LOCALLY@127.0.0.1:5434/talkie_transcripts
APP_ORIGIN=http://127.0.0.1:3000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# Optional private Gemini Live test (/voice). Confirm this key's project is Free tier in AI Studio.
# Never use NEXT_PUBLIC_ for the key. Paid project usage is outside this test authorization.
GOOGLE_API_KEY=
TALKIE_VOICE_TEST=disabled
GEMINI_FREE_TIER_CONFIRMED=false
