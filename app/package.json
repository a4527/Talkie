{
  "name": "talkie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/learning.test.ts",
    "test:e2e": "playwright test --config tests/browser/playwright.config.ts",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; for (const path of ['.next', 'test-results', 'playwright-report', 'tsconfig.tsbuildinfo']) rmSync(path, { recursive: true, force: true });\""
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
