#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
python3 "$repo_root/scripts/check_secrets.py" --tracked

if [ -x "$repo_root/.tools/gitleaks" ]; then
    scanner="$repo_root/.tools/gitleaks"
elif command -v gitleaks >/dev/null 2>&1; then
    scanner=gitleaks
else
    echo "Push blocked: install Gitleaks (see README.md) before pushing." >&2
    exit 1
fi

exec "$scanner" git --redact --no-banner .
